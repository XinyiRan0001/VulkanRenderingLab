#version 460
layout(local_size_x=64) in;
struct RayTriangle{vec4 a,b,c,na,nb,nc,color,properties,uv01,uv2;};
layout(set=0,binding=1,std430) buffer Triangles{RayTriangle triangles[];};
layout(set=0,binding=4,std430) readonly buffer Vertices{float vertices[];};
layout(set=0,binding=5,std430) readonly buffer Metadata{uvec4 indices[];};
layout(push_constant) uniform Settings{uint count;} settings;
vec4 position(uint i){uint b=i*15;return vec4(vertices[b],vertices[b+1],vertices[b+2],1);}
vec4 normal(uint i){uint b=i*15+6;return vec4(vertices[b],vertices[b+1],vertices[b+2],0);}
vec2 uv(uint i){uint b=i*15+9;return vec2(vertices[b],vertices[b+1]);}
void main(){uint i=gl_GlobalInvocationID.x;if(i>=settings.count)return;uvec3 ids=indices[i].xyz;
triangles[i].a=position(ids.x);triangles[i].b=position(ids.y);triangles[i].c=position(ids.z);
triangles[i].na=normal(ids.x);triangles[i].nb=normal(ids.y);triangles[i].nc=normal(ids.z);
triangles[i].uv01=vec4(uv(ids.x),uv(ids.y));triangles[i].uv2=vec4(uv(ids.z),0,0);}
