#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D currentAo;
layout(binding=1) uniform sampler2D currentNormal;
layout(binding=2) uniform sampler2D currentDepth;
layout(binding=3) uniform sampler2D motionTexture;
layout(binding=4) uniform sampler2D historyAo;
layout(binding=5) uniform sampler2D historyGeometry;
layout(r32f,binding=6) uniform writeonly image2D outputAo;
layout(rgba32f,binding=7) uniform writeonly image2D nextAo;
layout(rgba32f,binding=8) uniform writeonly image2D nextGeometry;
layout(std140,binding=9) uniform State {
    mat4 inverseView; mat4 previousInverseProjection; ivec4 settings;
} s;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy), size=s.settings.xy;
    if(any(greaterThanEqual(p,size)))return;
    vec4 normal=texelFetch(currentNormal,p,0), motion=texelFetch(motionTexture,p,0);
    float current=texelFetch(currentAo,p,0).r, result=current, weight=0;
    vec3 worldNormal=normal.a>0?normalize(mat3(s.inverseView)*normal.xyz):vec3(0);
    // Codes: 0 background, 1 reset/off, 2 previous projection invalid,
    // 3 geometry/identity rejected, 4 history accepted, 5 adaptive weight reduced.
    float reason=normal.a>0?1:0;
    if(normal.a<=0) result=1;
    else if(s.settings.z!=0 && (s.settings.w&1)!=0) {
        reason=2;
        if(motion.w>0) {
            vec2 uv=(vec2(p)+.5)/vec2(size)+motion.xy;
            vec4 previous=s.previousInverseProjection*vec4(uv*2-1,motion.z,1);
            float expected=-previous.z/previous.w;
            vec2 coord=uv*vec2(size)-.5;
            ivec2 base=ivec2(floor(coord));
            float sum=0, validWeight=0;
            reason=3;
            for(int y=0;y<2;++y)for(int x=0;x<2;++x) {
                ivec2 q=base+ivec2(x,y);
                if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,size)))continue;
                vec4 old=texelFetch(historyAo,q,0), geometry=texelFetch(historyGeometry,q,0);
                // Each bilinear tap must refer to the same visible surface.
                // Conservative depth tolerance deliberately sacrifices history on steep slopes.
                if(geometry.a<=0 || abs(old.y-motion.w)>.25 || dot(worldNormal,geometry.xyz)<.9 ||
                   abs(geometry.a-expected)>max(.01,.005*expected))continue;
                vec2 w=max(vec2(0),vec2(1)-abs(coord-vec2(q)));
                float tap=w.x*w.y; sum+=old.x*tap;validWeight+=tap;
            }
            if(validWeight>1e-5) {
                float low=current, high=current;
                for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x) {
                    ivec2 q=clamp(p+ivec2(x,y),ivec2(0),size-1);
                    float a=texelFetch(currentAo,q,0).r;low=min(low,a);high=max(high,a);
                }
                float history=clamp(sum/validWeight,low,high);
                weight=.85*min(validWeight,1)*exp(-length(motion.xy*vec2(size))/32);
                result=mix(current,history,weight);reason=4;
                if((s.settings.w&2)!=0) {
                    float response=smoothstep(.005,.05,abs(current-history));
                    weight*=1-response;
                    result=mix(current,history,weight);
                    if(response>0)reason=5;
                }
            }
        }
    }
    imageStore(outputAo,p,vec4(result));
    imageStore(nextAo,p,vec4(result,abs(motion.w),weight,reason));
    imageStore(nextGeometry,p,vec4(worldNormal,normal.a));
}
