#version 450

layout(binding = 0) uniform sampler2D hdrTexture;

/*
 * Direction generated by the cube vertex shader.
 *
 * The variable name does not need to match the vertex shader,
 * but location 0 and vec3 must match.
 */
layout(location = 0) in vec3 localDirection;

layout(location = 0) out vec4 outColor;

const vec2 inverseAtan =
    vec2(
        0.15915494309, // 1 / (2 * PI)
        0.31830988618  // 1 / PI
    );

vec2 DirectionToEquirectangularUV(
    vec3 direction
)
{
    direction =
        normalize(direction);

    vec2 uv =
        vec2(
            atan(
                direction.z,
                direction.x
            ),
            asin(
                clamp(
                    direction.y,
                    -1.0,
                    1.0
                )
            )
        );

    uv *=
        inverseAtan;

    uv +=
        0.5;

    return uv;
}

void main()
{
    vec3 direction =
        normalize(localDirection);

    vec2 uv =
        DirectionToEquirectangularUV(
            direction
        );

    vec3 hdrColor =
        texture(
            hdrTexture,
            uv
        ).rgb;

    outColor =
        vec4(
            hdrColor,
            1.0
        );
}