#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D normalTexture;
layout(binding=1) uniform sampler2D depthTexture;
layout(std140,binding=2) uniform Preview {
    mat4 inverseProjection; mat4 inverseView; ivec4 settings; vec4 parameters;
    mat4 projection; vec4 kernel[64];
} v;
layout(r32f,binding=3) uniform writeonly image2D rawAo;
vec3 reconstruct(ivec2 pixel,float depth) {
    vec2 uv=(vec2(pixel)+.5)/vec2(v.settings.yz);
    vec4 p=v.inverseProjection*vec4(uv*2-1,depth,1);
    return p.xyz/p.w;
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy), size=v.settings.yz;
    if(any(greaterThanEqual(pixel,size))) return;
    float visibility=1;
    vec4 normal=texelFetch(normalTexture,pixel,0);
    float depth=texelFetch(depthTexture,pixel,0).r;
    if(normal.a>0 && depth<1) {
        vec3 p=reconstruct(pixel,depth), n=normalize(normal.xyz);
        // A stable 4x4 rotation tile: deterministic, no per-frame shimmer.
        const float angles[16]=float[](0.07,0.67,0.27,0.87,0.47,0.17,0.97,0.57,0.77,0.37,0.12,0.72,0.32,0.92,0.52,0.22);
        float angle=angles[(pixel.y%4)*4+pixel.x%4]*6.2831853;
        vec3 axis=abs(n.z)<.999 ? vec3(0,0,1):vec3(0,1,0);
        vec3 t=normalize(cross(axis,n)), b=cross(n,t);
        vec3 tangent=t*cos(angle)+b*sin(angle);
        mat3 basis=mat3(tangent,cross(n,tangent),n);
        float radius=v.parameters.y, bias=v.parameters.z, blocked=0;
        for(int i=0;i<v.settings.w;++i) {
            vec3 q=p+basis*v.kernel[i].xyz*radius;
            vec4 clip=v.projection*vec4(q,1);
            if(clip.w<=0) continue;
            vec3 ndc=clip.xyz/clip.w;
            vec2 uv=ndc.xy*.5+.5;
            if(ndc.z<0 || ndc.z>=1 || any(lessThan(uv,vec2(0))) || any(greaterThanEqual(uv,vec2(1)))) continue;
            ivec2 other=ivec2(uv*vec2(size));
            float sceneDepth=texelFetch(depthTexture,other,0).r;
            if(sceneDepth>=1) continue;
            vec3 surface=reconstruct(other,sceneDepth);
            // A snapped pixel center on the same plane can appear in front of Q.
            // Only geometry above the receiver tangent plane can block its hemisphere.
            if(dot(surface-p,n)<=bias) continue;
            // Reject distant layers and attenuate to zero at the radius boundary.
            float weight=1-smoothstep(0,radius,length(surface-p));
            blocked+=(surface.z>=q.z+bias?1:0)*weight;
        }
        // Missing screen-space information contributes no occlusion, avoiding edge bands.
        visibility=clamp(1-blocked/float(v.settings.w),0,1);
    }
    imageStore(rawAo,pixel,vec4(visibility));
}
